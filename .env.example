# ==========================================
# Puppy Blogger - Docker Compose Environment
# ==========================================

# Public Host / IP / Domain
# For local testing: localhost
# For AWS Ubuntu: your-public-ip (e.g. 13.234.12.34) or your-domain.com
SERVER_HOST=localhost

# Database Configuration
MONGO_PORT=27017
MONGO_DATABASE=puppy

# Backend API Service
BACKEND_PORT=5001
CORS_URL=http://localhost:3000

# JWT Authentication Secrets (Replace with secure random strings for production)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_in_production
ACCESS_TOKEN_EXP=1d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_in_production
REFRESH_TOKEN_EXP=7d
RESET_PASSWORD_SECRET=your_super_secret_reset_password_key_change_in_production
RESET_PASSWORD_EXP=5m

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="Puppy Blogs <onboarding@resend.dev>"
BASE_URL=http://localhost:3000

# Frontend Next.js Service
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001/api/v1
AUTH_SECRET=your_nextauth_auth_secret_minimum_32_chars_long
NEXTAUTH_URL=http://localhost:3000
